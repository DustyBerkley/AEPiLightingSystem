<Page
    x:Class="AEPiLightingSystem.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Settings"
    d:DesignHeight="600"
    d:DesignWidth="800"
    Background="Transparent">

    <StackPanel Margin="32,24,32,24">

        <TextBlock
            Margin="0,0,0,4"
            FontSize="28"
            FontWeight="SemiBold"
            Text="Settings" />
        <TextBlock
            Margin="0,0,0,24"
            Opacity="0.6"
            Text="App preferences." />

        <ui:Card Padding="20">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,12"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Appearance" />
                <StackPanel Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,8,0"
                        Appearance="Primary"
                        Click="OnLightThemeClick"
                        Content="Light" />
                    <ui:Button Click="OnDarkThemeClick" Content="Dark" />
                </StackPanel>
            </StackPanel>
        </ui:Card>

    </StackPanel>
</Page>
