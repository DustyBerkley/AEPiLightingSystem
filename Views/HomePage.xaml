<Page
    x:Class="AEPiLightingSystem.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Home"
    d:DesignHeight="600"
    d:DesignWidth="800"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,24">

            <TextBlock
                Margin="0,0,0,4"
                FontSize="28"
                FontWeight="SemiBold"
                Text="Welcome back" />
            <TextBlock
                Margin="0,0,0,24"
                Opacity="0.6"
                Text="Here's the current state of the house lighting." />

            <UniformGrid Columns="3" Rows="1">
                <ui:CardControl Margin="0,0,8,0">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon FontSize="24" Symbol="LightbulbFilament24" />
                    </ui:CardControl.Icon>
                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="12" />
                        <TextBlock Opacity="0.6" Text="Lights On" />
                    </StackPanel>
                </ui:CardControl>

                <ui:CardControl Margin="8,0,8,0">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon FontSize="24" Symbol="Home24" />
                    </ui:CardControl.Icon>
                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="5" />
                        <TextBlock Opacity="0.6" Text="Zones" />
                    </StackPanel>
                </ui:CardControl>

                <ui:CardControl Margin="8,0,0,0">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon FontSize="24" Symbol="FlashCheckmark24" />
                    </ui:CardControl.Icon>
                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Online" />
                        <TextBlock Opacity="0.6" Text="Controller Status" />
                    </StackPanel>
                </ui:CardControl>
            </UniformGrid>

            <ui:Card Margin="0,24,0,0" Padding="20">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,16"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Master Control" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="All lights" />
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="True" />
                    </Grid>

                    <TextBlock Margin="0,0,0,8" Opacity="0.6" Text="Brightness" />
                    <Slider
                        Maximum="100"
                        Minimum="0"
                        TickFrequency="10"
                        Value="70" />
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</Page>
