<ui:FluentWindow
    x:Class="AEPiLightingSystem.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:AEPiLightingSystem.Controls"
    xmlns:conv="clr-namespace:AEPiLightingSystem.Converters"
    mc:Ignorable="d"
    Title="AEPi Lighting System"
    Width="1200"
    Height="750"
    MinWidth="900"
    MinHeight="560"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None"
    WindowCornerPreference="Round"
    WindowStartupLocation="Manual"
    Background="#FF080808">

    <Window.Resources>
        <!--  Overrides WPF-UI's themed brush; FluentWindow paints via this resource, not Window.Background.  -->
        <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FF080808" />

        <conv:ColorToBrushConverter x:Key="ColorToBrushConverter" />
        <conv:DoubleToStarGridLengthConverter x:Key="DoubleToStarGridLengthConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:FaderActivationToBrushConverter x:Key="FaderActivationToBrushConverter" />
        <conv:PageActiveToBrushConverter x:Key="PageActiveToBrushConverter" />
        <conv:PageActiveToOpacityConverter x:Key="PageActiveToOpacityConverter" />

        <PointCollection x:Key="HexagonPoints">25,0 75,0 100,43.5 75,87 25,87 0,43.5</PointCollection>

        <Style x:Key="ParHexagonStyle" TargetType="Polygon">
            <Setter Property="Points" Value="{StaticResource HexagonPoints}" />
            <Setter Property="Stretch" Value="Fill" />
            <Setter Property="Width" Value="94" />
            <Setter Property="Height" Value="82" />
            <Setter Property="StrokeThickness" Value="16" />
            <Setter Property="Fill" Value="{Binding Color, Converter={StaticResource ColorToBrushConverter}}" />
            <Setter Property="Stroke" Value="{Binding Color, Converter={StaticResource ColorToBrushConverter}, ConverterParameter=0.5}" />
        </Style>

        <!--  Floor par lights sit below the wall ones and read as smaller/closer in the layout.  -->
        <Style x:Key="ParHexagonStyleSmall" BasedOn="{StaticResource ParHexagonStyle}" TargetType="Polygon">
            <Setter Property="Width" Value="66" />
            <Setter Property="Height" Value="57" />
            <Setter Property="StrokeThickness" Value="11" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Image
            Grid.RowSpan="9"
            IsHitTestVisible="False"
            Opacity="0.035"
            Source="pack://application:,,,/Assets/background_texture.png"
            Stretch="UniformToFill" />

        <ui:TitleBar Grid.Row="0" Title="AEPi Lighting System">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Lightbulb24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!--  Which mode the whole rig is currently running in - see
              MainWindow.SetLightingMode. Full auto: automated animations
              only. Semi auto: automated animations + manual fader effects
              together. Manual: automated animations off, fader effects only.  -->
        <StackPanel
            Grid.Row="0"
            Margin="0,40,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top">
            <TextBlock
                x:Name="LightingModeText"
                HorizontalAlignment="Center"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="#AAFFFFFF"
                Text="Manual" />
            <StackPanel Margin="0,2,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                <ui:Button
                    x:Name="FullAutoModeButton"
                    Margin="2,0"
                    Content="Full Auto"
                    Click="LightingModeButton_Click" />
                <ui:Button
                    x:Name="SemiAutoModeButton"
                    Margin="2,0"
                    Content="Semi Auto"
                    Click="LightingModeButton_Click" />
                <ui:Button
                    x:Name="ManualModeButton"
                    Margin="2,0"
                    Content="Manual"
                    Click="LightingModeButton_Click" />
            </StackPanel>
        </StackPanel>

        <!--  Shown whenever neither deck is playing (and DMX is connected -
              see MainWindow.UpdateStatusBanners).  -->
        <TextBlock
            x:Name="RekordboxPausedText"
            Grid.Row="0"
            Margin="0,100,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            FontSize="28"
            FontWeight="SemiBold"
            Foreground="#CC0000"
            Text="Rekordbox Paused"
            Visibility="Collapsed" />

        <!--  Shown whenever DMX isn't connected - see MainWindow.UpdateStatusBanners. Visible by default since that's the actual starting state before any connect attempt. Takes priority over RekordboxPausedText when both would apply - same spot on screen, only one shows at a time.  -->
        <TextBlock
            x:Name="DmxNotDetectedText"
            Grid.Row="0"
            Margin="0,100,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            FontSize="28"
            FontWeight="SemiBold"
            Foreground="#CC0000"
            Text="DMX Not Detected"
            Visibility="Visible" />

        <!--  Audio capture status, plus the audio-source dropdown that picks
              which playback device (including a connected Bluetooth speaker)
              the automated lighting effects listen to - see AudioCaptureService.  -->
        <StackPanel
            Grid.Row="0"
            Margin="24,50,24,4"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Orientation="Horizontal">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="#AAFFFFFF"
                Text="Audio source:" />
            <ComboBox
                x:Name="AudioSourceComboBox"
                Width="160"
                Margin="6,0,16,0"
                DisplayMemberPath="Name"
                DropDownOpened="AudioSourceComboBox_DropDownOpened"
                SelectionChanged="AudioSourceComboBox_SelectionChanged" />
            <!--  TEMP: laser wave/chord detector status, for correlating against real audio. Remove when done.  -->
            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="#AAFFFFFF"
                Text="Wave: " />
            <TextBlock
                x:Name="WaveStatusText"
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="#AAFFFFFF"
                Text="Inactive" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="#AAFFFFFF"
                Text="Chord: " />
            <TextBlock
                x:Name="ChordStatusText"
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="#AAFFFFFF"
                Text="Inactive" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="#AAFFFFFF"
                Text="Audio: " />
            <TextBlock
                x:Name="AudioDeviceStatusText"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="#AAFFFFFF"
                Text="Not listening" />
        </StackPanel>

        <!--  BPM of whichever deck currently has the higher channel volume -
              see MainWindow.UpdateMasterBpm. Pinned to the top-left corner
              of the window, above/beside the title bar's own icon+text.  -->
        <StackPanel
            Grid.Row="0"
            Margin="20,50,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Normal"
                    Foreground="#AAFFFFFF"
                    Text="BPM " />
                <TextBlock
                    x:Name="MasterBpmText"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Normal"
                    Foreground="#FFFFFFFF"
                    Text="--" />

                <!--  Current beat (1-4) within the measure, inferred from the
                      master-deck measure-start marker + master BPM - see
                      MainWindow.UpdateBeatNumber/FlashBeatNumber.  -->
                <TextBlock
                    x:Name="BeatNumberText"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="#FFFFFFFF"
                    Text="-" />
            </StackPanel>

            <!--  Whichever deck currently has the higher channel volume - see MainWindow.UpdateMasterBpm.  -->
            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="#AAFFFFFF"
                    Text="Master: " />
                <TextBlock
                    x:Name="MasterDeckText"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="#AAFFFFFF"
                    Text="--" />
            </StackPanel>
        </StackPanel>

        <!--  DMX connection bar - pinned into Row 0 like the BPM/status
              panels above it, since Row 1/2 no longer reliably reserve the
              space this used to sit in after those panels moved.  -->
        <StackPanel
            Grid.Row="0"
            Margin="24,78,24,8"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Orientation="Horizontal">
            <TextBlock
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="#AAFFFFFF"
                Text="DMX port:" />
            <ComboBox
                x:Name="DmxPortComboBox"
                Width="140"
                DropDownOpened="DmxPortComboBox_DropDownOpened" />
            <ui:Button
                x:Name="DmxConnectButton"
                Margin="10,0,0,0"
                Content="Connect"
                Click="DmxConnectButton_Click" />
            <TextBlock
                x:Name="DmxStatusText"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="#AAFFFFFF"
                Text="Not connected" />
        </StackPanel>

        <!--  Live mirror of the center 700x150px of the middle monitor,
              where Rekordbox runs fullscreen (see ScreenMirrorCapture), plus
              the per-deck BPM/volume values read off of it (see BpmReader/
              VolumeReader). Hidden now that everything's tuned and combined
              into the single master BPM readout up in the status bar - the
              captures/readers underneath keep running regardless, since
              nothing here is bound to Visibility.  -->
        <StackPanel
            Grid.Row="3"
            Margin="24,4,24,8"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Visibility="Collapsed">
            <!--  Full-width mirror - kept alive (BpmReader still crops its
                  frames off RekordboxMirrorImage every tick) but no longer
                  shown, now that the crop regions below are tuned.  -->
            <Border
                Background="#FF040404"
                BorderBrush="#22FFFFFF"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="Collapsed">
                <Grid Width="700" Height="150">
                    <Image
                        x:Name="RekordboxMirrorImage"
                        Stretch="Uniform" />

                    <!--  Shows exactly where BpmReader.Deck1Region/Deck2Region
                          crop from, drawn over the live mirror - positioned
                          from code-behind in the MainWindow constructor.
                          Purely a calibration aid for tuning those crop
                          rectangles against reality.  -->
                    <Canvas IsHitTestVisible="False">
                        <Rectangle
                            x:Name="Deck1RegionOverlay"
                            Stroke="#FF00FF00"
                            StrokeThickness="2" />
                        <Rectangle
                            x:Name="Deck2RegionOverlay"
                            Stroke="#FF00AAFF"
                            StrokeThickness="2" />
                    </Canvas>
                </Grid>
            </Border>

            <!--  Same height as the full mirror above, a quarter the width,
                  centered on the same fixed point (see ScreenMirrorCapture).  -->
            <Border
                Background="#FF040404"
                BorderBrush="#22FFFFFF"
                BorderThickness="1"
                CornerRadius="4">
                <Image
                    x:Name="NarrowMirrorImage"
                    Width="85"
                    Height="60"
                    Stretch="Uniform" />
            </Border>

            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Width="80"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#AAFFFFFF"
                        Text="Deck 1 BPM:" />
                    <TextBlock
                        x:Name="Deck1BpmText"
                        Width="50"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#FFFFFFFF"
                        Text="--" />
                    <Image x:Name="Deck1BpmDebugImage" Height="30" />
                </StackPanel>
                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                    <TextBlock
                        Width="80"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#AAFFFFFF"
                        Text="Deck 2 BPM:" />
                    <TextBlock
                        x:Name="Deck2BpmText"
                        Width="50"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#FFFFFFFF"
                        Text="--" />
                    <Image x:Name="Deck2BpmDebugImage" Height="30" />
                </StackPanel>
                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                    <TextBlock
                        Width="80"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#AAFFFFFF"
                        Text="Deck 1 Vol:" />
                    <TextBlock
                        x:Name="Deck1VolumeText"
                        Width="50"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#FFFFFFFF"
                        Text="--" />
                </StackPanel>
                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                    <TextBlock
                        Width="80"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#AAFFFFFF"
                        Text="Deck 2 Vol:" />
                    <TextBlock
                        x:Name="Deck2VolumeText"
                        Width="50"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#FFFFFFFF"
                        Text="--" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!--  Measure/beat pixel-tracking capture + readouts - hidden again
              now that it's tuned; the capture/detection in
              _topCaptureTimer.Tick keeps running regardless.  -->
        <StackPanel
            Grid.Row="4"
            Margin="24,4,24,8"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Visibility="Collapsed">
            <Border
                Background="#FF040404"
                BorderBrush="#22FFFFFF"
                BorderThickness="1"
                CornerRadius="4">
                <Grid Width="30" Height="40">
                    <Image
                        x:Name="TopCaptureImage"
                        Stretch="Uniform" />

                    <!--  Deck 1 marker: 1px dot, 1px up and 1px left of the box's center (15,20) -> (14,19), then nudged 2px further left.  -->
                    <Rectangle
                        Width="1"
                        Height="1"
                        Margin="13,18,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Fill="#FF00FF00"
                        IsHitTestVisible="False" />

                    <!--  Deck 2 marker: same spot, 5px further down.  -->
                    <Rectangle
                        Width="1"
                        Height="1"
                        Margin="13,23,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Fill="#FFFFFF00"
                        IsHitTestVisible="False" />
                </Grid>
            </Border>

            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Rectangle
                        x:Name="Deck1MarkerIndicator"
                        Width="14"
                        Height="14"
                        Margin="0,0,8,0"
                        Fill="#FF444444"
                        Stroke="#22FFFFFF"
                        StrokeThickness="1" />
                    <TextBlock
                        x:Name="Deck1MarkerText"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#AAFFFFFF"
                        Text="--" />

                    <!--  The literal color sampled under the dot, not just the exact-match check above.  -->
                    <Rectangle
                        x:Name="Deck1ColorSwatch"
                        Width="14"
                        Height="14"
                        Margin="16,0,8,0"
                        Fill="#FF444444"
                        Stroke="#22FFFFFF"
                        StrokeThickness="1" />
                    <TextBlock
                        x:Name="Deck1ColorText"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#AAFFFFFF"
                        Text="--" />

                    <!--  Increments once per rising edge into #3F0000 - see MainWindow's _topCaptureTimer.Tick.  -->
                    <TextBlock
                        x:Name="Deck1MeasureText"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#AAFFFFFF"
                        Text="Deck 1 measures: 0" />
                </StackPanel>

                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                    <Rectangle
                        x:Name="Deck2MarkerIndicator"
                        Width="14"
                        Height="14"
                        Margin="0,0,8,0"
                        Fill="#FF444444"
                        Stroke="#22FFFFFF"
                        StrokeThickness="1" />
                    <TextBlock
                        x:Name="Deck2MarkerText"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#AAFFFFFF"
                        Text="--" />

                    <Rectangle
                        x:Name="Deck2ColorSwatch"
                        Width="14"
                        Height="14"
                        Margin="16,0,8,0"
                        Fill="#FF444444"
                        Stroke="#22FFFFFF"
                        StrokeThickness="1" />
                    <TextBlock
                        x:Name="Deck2ColorText"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#AAFFFFFF"
                        Text="--" />

                    <TextBlock
                        x:Name="Deck2MeasureText"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#AAFFFFFF"
                        Text="Deck 2 measures: 0" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!--  30x30 captures right below the bottom-right corner of the BPM
              capture box above (see MainWindow's _cornerCapture/
              _deck2CornerCapture, positioned from _topCapture's own
              OriginX/OriginY/Width/Height) - each deck's playing/paused
              indicator, stacked so they don't overlap.  -->
        <StackPanel Grid.Row="5" Margin="24,4,24,8" HorizontalAlignment="Center" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Border
                    Background="#FF040404"
                    BorderBrush="#22FFFFFF"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Image
                        x:Name="CornerCaptureImage"
                        Width="30"
                        Height="30"
                        Stretch="Uniform" />
                </Border>

                <!--  Color of the pixel at the middle of the box (15,15) - see MainWindow's _cornerCaptureTimer.Tick.  -->
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <Rectangle
                        x:Name="CornerCaptureColorSwatch"
                        Width="14"
                        Height="14"
                        Margin="0,0,8,0"
                        Fill="#FF444444"
                        Stroke="#22FFFFFF"
                        StrokeThickness="1" />
                    <TextBlock
                        x:Name="CornerCaptureColorText"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#AAFFFFFF"
                        Text="--" />

                    <!--  #575757 = playing, anything else = paused - see MainWindow's _cornerCaptureTimer.Tick.  -->
                    <TextBlock
                        x:Name="Deck1PlaybackStatusText"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#AAFFFFFF"
                        Text="Deck 1: --" />
                </StackPanel>
            </StackPanel>

            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                <Border
                    Background="#FF040404"
                    BorderBrush="#22FFFFFF"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Image
                        x:Name="Deck2CornerCaptureImage"
                        Width="30"
                        Height="30"
                        Stretch="Uniform" />
                </Border>

                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <Rectangle
                        x:Name="Deck2CornerCaptureColorSwatch"
                        Width="14"
                        Height="14"
                        Margin="0,0,8,0"
                        Fill="#FF444444"
                        Stroke="#22FFFFFF"
                        StrokeThickness="1" />
                    <TextBlock
                        x:Name="Deck2CornerCaptureColorText"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#AAFFFFFF"
                        Text="--" />

                    <TextBlock
                        x:Name="Deck2PlaybackStatusText"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#AAFFFFFF"
                        Text="Deck 2: --" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!--  Grid is sized larger than the Viewbox's available space on
              purpose - Stretch="Uniform" scales (and centers) it down to
              fit, so enlarging this logical canvas shrinks every lighting
              effect GUI proportionally without needing to touch each one
              individually.  -->
        <Viewbox Grid.Row="6" Margin="24" Stretch="Uniform">
            <Grid Width="1500" Height="813">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Par lights  -->
                <StackPanel
                    Grid.Column="0"
                    Margin="0,0,70,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">

                    <!--  Wall striplight (Rockville Motionstrip 80W) - sits above the wall pars. The arrow shows which way the head is currently facing: 0deg points right (forward), 90deg points down.  -->
                    <StackPanel
                        Margin="0,0,0,24"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <Path
                            Width="16"
                            Height="16"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Data="M 0,0 L 16,8 L 0,16 Z"
                            DataContext="{Binding WallStripLight}"
                            Fill="#AAFFFFFF">
                            <Path.RenderTransform>
                                <RotateTransform Angle="{Binding DisplayFacingAngleDegrees}" CenterX="8" CenterY="8" />
                            </Path.RenderTransform>
                        </Path>
                        <ItemsControl ItemsSource="{Binding WallStripLight.Lights}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Rectangle
                                        Width="18"
                                        Height="30"
                                        Margin="2,0"
                                        Fill="{Binding Color, Converter={StaticResource ColorToBrushConverter}}"
                                        RadiusX="2"
                                        RadiusY="2"
                                        Stroke="{Binding Color, Converter={StaticResource ColorToBrushConverter}, ConverterParameter=0.5}"
                                        StrokeThickness="1.5" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Polygon
                            Margin="0,0,50,0"
                            DataContext="{Binding TopLeftPar}"
                            Style="{StaticResource ParHexagonStyle}" />
                        <Polygon
                            Margin="50,0,0,0"
                            DataContext="{Binding TopRightPar}"
                            Style="{StaticResource ParHexagonStyle}" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" Margin="0,14,0,0" Orientation="Horizontal">
                        <Polygon
                            Margin="0,0,14,0"
                            DataContext="{Binding BottomLeftPar}"
                            Style="{StaticResource ParHexagonStyle}" />
                        <Polygon
                            Margin="14,0,0,0"
                            DataContext="{Binding BottomRightPar}"
                            Style="{StaticResource ParHexagonStyle}" />
                    </StackPanel>

                    <!--  Floor par lights - smaller, arranged in a square below the wall pair.  -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,50,0,0">
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <Polygon
                                Margin="0,0,20,0"
                                DataContext="{Binding FloorTopLeftPar}"
                                Style="{StaticResource ParHexagonStyleSmall}" />
                            <Polygon
                                Margin="20,0,0,0"
                                DataContext="{Binding FloorTopRightPar}"
                                Style="{StaticResource ParHexagonStyleSmall}" />
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" Margin="0,20,0,0" Orientation="Horizontal">
                            <Polygon
                                Margin="0,0,20,0"
                                DataContext="{Binding FloorBottomLeftPar}"
                                Style="{StaticResource ParHexagonStyleSmall}" />
                            <Polygon
                                Margin="20,0,0,0"
                                DataContext="{Binding FloorBottomRightPar}"
                                Style="{StaticResource ParHexagonStyleSmall}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border
                    Grid.Column="1"
                    Width="1"
                    Margin="24,140"
                    Background="#22FFFFFF" />

                <!--  Laser (above) + ceiling light bars (below)  -->
                <StackPanel
                    Grid.Column="2"
                    Margin="70,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">

                    <!--  Laser - visualization only for now, no DMX output wired up yet  -->
                    <controls:LaserPanelView
                        Width="360"
                        Height="150"
                        Margin="0,0,0,28"
                        HorizontalAlignment="Center"
                        Laser="{Binding Laser}" />

                    <!--  Ceiling light bars, top-down with the front of the room
                          at the top. Each bar runs front-to-back; they zigzag
                          left/right, each one starting further back than the
                          one before it.  -->
                    <Canvas Width="360" Height="362" HorizontalAlignment="Center">
                        <TextBlock Canvas.Left="0" Canvas.Top="0" Width="360" FontSize="11" Foreground="#55FFFFFF" Text="FRONT" TextAlignment="Center" />
                        <controls:LightBarView Canvas.Left="120" Canvas.Top="22" Width="28" Height="120" Bar="{Binding FrontLeftBar}" />
                        <controls:LightBarView Canvas.Left="212" Canvas.Top="76" Width="28" Height="120" Bar="{Binding FrontRightBar}" />
                        <controls:LightBarView Canvas.Left="120" Canvas.Top="168" Width="28" Height="120" Bar="{Binding BackLeftBar}" />
                        <controls:LightBarView Canvas.Left="212" Canvas.Top="222" Width="28" Height="120" Bar="{Binding BackRightBar}" />
                        <TextBlock Canvas.Left="0" Canvas.Top="346" Width="360" FontSize="11" Foreground="#55FFFFFF" Text="BACK" TextAlignment="Center" />
                    </Canvas>
                </StackPanel>
            </Grid>
        </Viewbox>

        <!--  Placeholder for the 8-fader MIDI board (not yet purchased) -
              one wide/short box per fader, shifted toward the right with the
              page-selector buttons to their left. The bottom 6px of each box
              is a 2-segment progress bar (filled/unfilled, star-sized off
              Value/RemainingValue so it always fills the box's actual width
              regardless of window size). Nothing feeds MidiFader.Value from
              real hardware yet, and the page buttons don't switch anything
              yet either - each fader page (bass, buildup, laser, light bar,
              combo) is future work.  -->
        <Grid Grid.Row="7" Margin="24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Every currently-active (Value > 0, not invalidated) fader
                  effect across all 4 pages, not just whichever page is
                  selected below - effects keep running in the background
                  once you switch away from their page (see the
                  Update*FaderEffect methods), so this is the only place to
                  see all of them at a glance. Each box is the same
                  FaderBoxView used below, just smaller/shifted-down icons
                  (so they clear the page-name label overlaid on top) and
                  dimmed as a whole - not just the label - when its page
                  isn't the one currently open. See
                  MainWindow.HookActiveFaderEffectsList.  -->
            <ItemsControl
                x:Name="ActiveFaderEffectsItemsControl"
                Grid.Row="0"
                Grid.Column="2"
                Margin="0,0,0,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="150" Margin="0,0,0,8">
                            <controls:FaderBoxView IconScale="0.7" IconVerticalOffset="16">
                                <controls:FaderBoxView.DimOpacity>
                                    <MultiBinding Converter="{StaticResource PageActiveToOpacityConverter}">
                                        <Binding Path="Page" />
                                        <Binding Path="DataContext.SelectedFaderPage" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    </MultiBinding>
                                </controls:FaderBoxView.DimOpacity>
                            </controls:FaderBoxView>
                            <TextBlock
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Text="{Binding PageDisplayName}">
                                <TextBlock.Foreground>
                                    <MultiBinding Converter="{StaticResource PageActiveToBrushConverter}">
                                        <Binding Path="Page" />
                                        <Binding Path="DataContext.SelectedFaderPage" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    </MultiBinding>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  Which set of fader mappings is active - purely a page
                  selector for now, nothing behind these pages is wired up
                  yet. See MainWindow.SelectFaderPage. No Margin on the
                  buttons themselves - HorizontalAlignment/VerticalAlignment
                  Center keeps the gap between them even regardless of each
                  button's own content width, since UniformGrid always gives
                  every cell the same size.  -->
            <UniformGrid
                Grid.Row="1"
                Grid.Column="0"
                Columns="2"
                Rows="2"
                VerticalAlignment="Center">
                <ui:Button
                    x:Name="FaderPageBassButton"
                    Margin="0,4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="Pars"
                    Click="FaderPageButton_Click" />
                <ui:Button
                    x:Name="FaderPageLaserButton"
                    Margin="0,4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="Laser"
                    Click="FaderPageButton_Click" />
                <ui:Button
                    x:Name="FaderPageLightBarButton"
                    Margin="0,4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="Light Bars"
                    Click="FaderPageButton_Click" />
                <ui:Button
                    x:Name="FaderPageComboButton"
                    Margin="0,4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="Combo"
                    Click="FaderPageButton_Click" />
            </UniformGrid>

            <!--  ItemsSource is set from code-behind (MainWindow.SelectFaderPage) rather
                  than bound here, since it needs to swap between Rig.BassFaders/
                  LaserFaders/LightBarFaders/ComboFaders as the page selection changes.  -->
            <ItemsControl
                x:Name="FaderItemsControl"
                Grid.Row="1"
                Grid.Column="2">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="8" Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:FaderBoxView />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!--  Full monitor width, 150px tall (source), starting 150px down
              from the monitor's own top edge (see MainWindow's
              _fullWidthCapture) - docked at the very bottom of the app
              window, stretched to the window's own width.  -->
        <Border
            Grid.Row="8"
            Margin="0"
            Background="#FF040404"
            BorderBrush="#22FFFFFF"
            BorderThickness="1,1,1,0"
            CornerRadius="0">
            <Image
                x:Name="FullWidthCaptureImage"
                Height="150"
                Stretch="Fill" />
        </Border>
    </Grid>
</ui:FluentWindow>
