<ui:FluentWindow
    x:Class="AEPiLightingSystem.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:AEPiLightingSystem.Controls"
    xmlns:conv="clr-namespace:AEPiLightingSystem.Converters"
    mc:Ignorable="d"
    Title="AEPi Lighting System"
    Width="1200"
    Height="750"
    MinWidth="900"
    MinHeight="560"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    Background="#FF080808">

    <Window.Resources>
        <!--  Overrides WPF-UI's themed brush; FluentWindow paints via this resource, not Window.Background.  -->
        <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FF080808" />

        <conv:ColorToBrushConverter x:Key="ColorToBrushConverter" />

        <PointCollection x:Key="HexagonPoints">25,0 75,0 100,43.5 75,87 25,87 0,43.5</PointCollection>

        <Style x:Key="ParHexagonStyle" TargetType="Polygon">
            <Setter Property="Points" Value="{StaticResource HexagonPoints}" />
            <Setter Property="Stretch" Value="Fill" />
            <Setter Property="Width" Value="94" />
            <Setter Property="Height" Value="82" />
            <Setter Property="StrokeThickness" Value="16" />
            <Setter Property="Fill" Value="{Binding Color, Converter={StaticResource ColorToBrushConverter}}" />
            <Setter Property="Stroke" Value="{Binding Color, Converter={StaticResource ColorToBrushConverter}, ConverterParameter=0.5}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Image
            Grid.RowSpan="2"
            IsHitTestVisible="False"
            Opacity="0.035"
            Source="pack://application:,,,/Assets/background_texture.png"
            Stretch="UniformToFill" />

        <ui:TitleBar Grid.Row="0" Title="AEPi Lighting System">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Lightbulb24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Viewbox Grid.Row="1" Margin="24" Stretch="Uniform">
            <Grid Width="1200" Height="650">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Par lights  -->
                <StackPanel
                    Grid.Column="0"
                    Margin="0,0,70,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">

                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Polygon
                            Margin="0,0,26,0"
                            DataContext="{Binding TopLeftPar}"
                            Style="{StaticResource ParHexagonStyle}" />
                        <Polygon
                            Margin="26,0,0,0"
                            DataContext="{Binding TopRightPar}"
                            Style="{StaticResource ParHexagonStyle}" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" Margin="0,36,0,0" Orientation="Horizontal">
                        <Polygon
                            Margin="0,0,50,0"
                            DataContext="{Binding BottomLeftPar}"
                            Style="{StaticResource ParHexagonStyle}" />
                        <Polygon
                            Margin="50,0,0,0"
                            DataContext="{Binding BottomRightPar}"
                            Style="{StaticResource ParHexagonStyle}" />
                    </StackPanel>
                </StackPanel>

                <Border
                    Grid.Column="1"
                    Width="1"
                    Margin="24,140"
                    Background="#22FFFFFF" />

                <!--  LED strips  -->
                <StackPanel
                    Grid.Column="2"
                    Margin="70,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <controls:LedStripView Width="12" Height="340" Margin="18,0" Strip="{Binding LedStrips[0]}" />
                    <controls:LedStripView Width="12" Height="340" Margin="18,0" Strip="{Binding LedStrips[1]}" />
                    <controls:LedStripView Width="12" Height="340" Margin="18,0" Strip="{Binding LedStrips[2]}" />
                    <controls:LedStripView Width="12" Height="340" Margin="18,0" Strip="{Binding LedStrips[3]}" />
                    <controls:LedStripView Width="12" Height="340" Margin="18,0" Strip="{Binding LedStrips[4]}" />
                    <controls:LedStripView Width="12" Height="340" Margin="18,0" Strip="{Binding LedStrips[5]}" />
                </StackPanel>
            </Grid>
        </Viewbox>
    </Grid>
</ui:FluentWindow>
