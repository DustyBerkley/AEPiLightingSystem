<UserControl
    x:Class="AEPiLightingSystem.Controls.FaderBoxView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:AEPiLightingSystem.Converters"
    x:Name="Root"
    mc:Ignorable="d"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
    <UserControl.Resources>
        <conv:FaderActivationToBrushConverter x:Key="FaderActivationToBrushConverter" />
        <conv:DoubleToStarGridLengthConverter x:Key="DoubleToStarGridLengthConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <PointCollection x:Key="HexagonPoints">25,0 75,0 100,43.5 75,87 25,87 0,43.5</PointCollection>
    </UserControl.Resources>
                        <!--  Border outline reads as this fader's own "is it
                              active" indicator too: the same translucent
                              gray as everywhere else while Value is 0,
                              brightening once it's activated at all - see
                              FaderActivationToBrushConverter.  -->
                        <Border
                            Height="64"
                            Margin="6,0"
                            Background="#FF040404"
                            BorderBrush="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Opacity="{Binding DimOpacity, ElementName=Root}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="6" />
                                </Grid.RowDefinitions>

                                <!--  Mini icon of the wall striplight + 4 wall par lights - what fader
                                      1's effect (see MainWindow.UpdateBassFaderEffect) actually controls.
                                      Same activation-based coloring as the border above - gray at 0%,
                                      bright once activated. Only fader 1 has an effect defined yet, so
                                      only its box gets one.  -->
                                <Grid Grid.Row="0" RenderTransformOrigin="0,0">
                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="{Binding IconScale, ElementName=Root}" ScaleY="{Binding IconScale, ElementName=Root}" />
                                            <TranslateTransform Y="{Binding IconVerticalOffset, ElementName=Root}" />
                                        </TransformGroup>
                                    </Grid.RenderTransform>
                                <StackPanel
                                    Grid.Row="0"
                                    Margin="5,5,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Index}" Value="1" />
                                                        <Condition Binding="{Binding Page}" Value="Bass" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                                <!--  Fader 1's effect on the Combo page (see
                                                      MainWindow.UpdateComboWallColorCycleFaderEffect) also
                                                      controls the wall striplight + 4 wall par lights, so it
                                                      reuses this exact same icon.  -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Index}" Value="1" />
                                                        <Condition Binding="{Binding Page}" Value="Combo" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Rectangle
                                        Width="40"
                                        Height="7"
                                        Margin="0,0,0,4"
                                        HorizontalAlignment="Center"
                                        Fill="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                        RadiusX="2"
                                        RadiusY="2" />

                                    <!--  Top pair spread wide, bottom pair close together - same
                                          asymmetry as the real wall par light layout in the main GUI.  -->
                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                        <Polygon
                                            Width="20"
                                            Height="16"
                                            Margin="0,0,8,0"
                                            Fill="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                            Points="{StaticResource HexagonPoints}"
                                            Stretch="Fill" />
                                        <Polygon
                                            Width="20"
                                            Height="16"
                                            Margin="8,0,0,0"
                                            Fill="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                            Points="{StaticResource HexagonPoints}"
                                            Stretch="Fill" />
                                    </StackPanel>
                                    <StackPanel Margin="0,3,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                        <Polygon
                                            Width="20"
                                            Height="16"
                                            Margin="0,0,2,0"
                                            Fill="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                            Points="{StaticResource HexagonPoints}"
                                            Stretch="Fill" />
                                        <Polygon
                                            Width="20"
                                            Height="16"
                                            Margin="2,0,0,0"
                                            Fill="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                            Points="{StaticResource HexagonPoints}"
                                            Stretch="Fill" />
                                    </StackPanel>
                                </StackPanel>

                                <!--  Mini icon for fader 2's effect (see MainWindow.UpdateDiagonalFaderEffect):
                                      same hexagons as fader 1's icon, no light bar. Top-left/bottom-right
                                      diagonal filled solid, the other diagonal outlined only - same
                                      filled-vs-outlined convention as fader 3's icon.  -->
                                <StackPanel
                                    Grid.Row="0"
                                    Margin="5,5,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Index}" Value="2" />
                                                        <Condition Binding="{Binding Page}" Value="Bass" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                        <!--  Top-left: filled (this diagonal).  -->
                                        <Polygon
                                            Width="20"
                                            Height="16"
                                            Margin="0,0,8,0"
                                            Fill="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                            Points="{StaticResource HexagonPoints}"
                                            Stretch="Fill" />
                                        <!--  Top-right: outlined (the other diagonal).  -->
                                        <Polygon
                                            Width="20"
                                            Height="16"
                                            Margin="8,0,0,0"
                                            Fill="Transparent"
                                            Points="{StaticResource HexagonPoints}"
                                            Stretch="Fill"
                                            Stroke="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                            StrokeThickness="1.5" />
                                    </StackPanel>
                                    <StackPanel Margin="0,3,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                        <!--  Bottom-left: outlined (the other diagonal).  -->
                                        <Polygon
                                            Width="20"
                                            Height="16"
                                            Margin="0,0,2,0"
                                            Fill="Transparent"
                                            Points="{StaticResource HexagonPoints}"
                                            Stretch="Fill"
                                            Stroke="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                            StrokeThickness="1.5" />
                                        <!--  Bottom-right: filled (this diagonal).  -->
                                        <Polygon
                                            Width="20"
                                            Height="16"
                                            Margin="2,0,0,0"
                                            Fill="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                            Points="{StaticResource HexagonPoints}"
                                            Stretch="Fill" />
                                    </StackPanel>
                                </StackPanel>

                                <!--  Mini icon for fader 3's effect (see MainWindow.UpdateTopBottomFaderEffect):
                                      same 4-hexagon layout as fader 1's icon, no light bar, bottom pair
                                      outlined only (not filled) to distinguish it from the top pair.  -->
                                <StackPanel
                                    Grid.Row="0"
                                    Margin="5,5,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Index}" Value="3" />
                                                        <Condition Binding="{Binding Page}" Value="Bass" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                        <Polygon
                                            Width="20"
                                            Height="16"
                                            Margin="0,0,8,0"
                                            Fill="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                            Points="{StaticResource HexagonPoints}"
                                            Stretch="Fill" />
                                        <Polygon
                                            Width="20"
                                            Height="16"
                                            Margin="8,0,0,0"
                                            Fill="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                            Points="{StaticResource HexagonPoints}"
                                            Stretch="Fill" />
                                    </StackPanel>
                                    <StackPanel Margin="0,3,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                        <Polygon
                                            Width="20"
                                            Height="16"
                                            Margin="0,0,2,0"
                                            Fill="Transparent"
                                            Points="{StaticResource HexagonPoints}"
                                            Stretch="Fill"
                                            Stroke="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                            StrokeThickness="1.5" />
                                        <Polygon
                                            Width="20"
                                            Height="16"
                                            Margin="2,0,0,0"
                                            Fill="Transparent"
                                            Points="{StaticResource HexagonPoints}"
                                            Stretch="Fill"
                                            Stroke="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                            StrokeThickness="1.5" />
                                    </StackPanel>
                                </StackPanel>

                                <!--  Mini icon for fader 4's effect (see MainWindow.UpdateLightBarFaderEffect):
                                      just the light bar, with a small arrow to its left pointing right -
                                      same "facing forward" arrow glyph used for the real wall striplight
                                      in the main GUI, just static (this effect always aims it at 0deg).  -->
                                <StackPanel
                                    Grid.Row="0"
                                    Margin="5,5,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Index}" Value="4" />
                                                        <Condition Binding="{Binding Page}" Value="Bass" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Path
                                        Width="8"
                                        Height="8"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        Data="M 0,0 L 8,4 L 0,8 Z"
                                        Fill="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}" />
                                    <Rectangle
                                        Width="40"
                                        Height="7"
                                        VerticalAlignment="Center"
                                        Fill="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                        RadiusX="2"
                                        RadiusY="2" />
                                </StackPanel>

                                <!--  Mini icon for fader 5's effect (see MainWindow.UpdateLightBarDownFaderEffect):
                                      same as fader 4's icon, just the arrow rotated to point down (this
                                      effect always aims the striplight at 90deg instead of 0deg).  -->
                                <StackPanel
                                    Grid.Row="0"
                                    Margin="5,5,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Index}" Value="5" />
                                                        <Condition Binding="{Binding Page}" Value="Bass" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Path
                                        Width="8"
                                        Height="8"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        Data="M 0,0 L 8,4 L 0,8 Z"
                                        Fill="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="90" CenterX="4" CenterY="4" />
                                        </Path.RenderTransform>
                                    </Path>
                                    <Rectangle
                                        Width="40"
                                        Height="7"
                                        VerticalAlignment="Center"
                                        Fill="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                        RadiusX="2"
                                        RadiusY="2" />
                                </StackPanel>

                                <!--  Mini icon for fader 6's effect (see MainWindow.UpdateFloorParFaderEffect):
                                      all 4 floor par lights flash together, so all 4 hexagons are filled -
                                      arranged in a uniform square (equal spacing both rows) rather than the
                                      asymmetric spread/close spacing used for the wall-par icons above, since
                                      there's no "these vs. those" grouping to distinguish here.  -->
                                <StackPanel
                                    Grid.Row="0"
                                    Margin="5,5,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Index}" Value="6" />
                                                        <Condition Binding="{Binding Page}" Value="Bass" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                        <Polygon
                                            Width="15"
                                            Height="12"
                                            Margin="0,0,2,0"
                                            Fill="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                            Points="{StaticResource HexagonPoints}"
                                            Stretch="Fill" />
                                        <Polygon
                                            Width="15"
                                            Height="12"
                                            Margin="2,0,0,0"
                                            Fill="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                            Points="{StaticResource HexagonPoints}"
                                            Stretch="Fill" />
                                    </StackPanel>
                                    <StackPanel Margin="0,2,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                        <Polygon
                                            Width="15"
                                            Height="12"
                                            Margin="0,0,2,0"
                                            Fill="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                            Points="{StaticResource HexagonPoints}"
                                            Stretch="Fill" />
                                        <Polygon
                                            Width="15"
                                            Height="12"
                                            Margin="2,0,0,0"
                                            Fill="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                            Points="{StaticResource HexagonPoints}"
                                            Stretch="Fill" />
                                    </StackPanel>
                                </StackPanel>

                                <!--  Mini icon for fader 7's effect (see MainWindow.UpdateLeftRightFloorParFaderEffect):
                                      same 4-hexagon floor-par layout as fader 6's icon, left column filled
                                      (this side), right column outlined (the other side) to show the
                                      left/right alternation.  -->
                                <StackPanel
                                    Grid.Row="0"
                                    Margin="5,5,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Index}" Value="7" />
                                                        <Condition Binding="{Binding Page}" Value="Bass" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                        <Polygon
                                            Width="15"
                                            Height="12"
                                            Margin="0,0,2,0"
                                            Fill="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                            Points="{StaticResource HexagonPoints}"
                                            Stretch="Fill" />
                                        <Polygon
                                            Width="15"
                                            Height="12"
                                            Margin="2,0,0,0"
                                            Fill="Transparent"
                                            Points="{StaticResource HexagonPoints}"
                                            Stretch="Fill"
                                            Stroke="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                            StrokeThickness="1.5" />
                                    </StackPanel>
                                    <StackPanel Margin="0,2,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                        <Polygon
                                            Width="15"
                                            Height="12"
                                            Margin="0,0,2,0"
                                            Fill="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                            Points="{StaticResource HexagonPoints}"
                                            Stretch="Fill" />
                                        <Polygon
                                            Width="15"
                                            Height="12"
                                            Margin="2,0,0,0"
                                            Fill="Transparent"
                                            Points="{StaticResource HexagonPoints}"
                                            Stretch="Fill"
                                            Stroke="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                            StrokeThickness="1.5" />
                                    </StackPanel>
                                </StackPanel>

                                <!--  Mini icon for fader 8's effect (see MainWindow.UpdateFloorParPlusWallTopFaderEffect):
                                      fader 3's own top/bottom-pair icon (the wall pars alternating top/bottom),
                                      plus the same 4 small hexagons as fader 6's icon (all 4 floor pars) to
                                      their right.  -->
                                <StackPanel
                                    Grid.Row="0"
                                    Margin="5,5,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Index}" Value="8" />
                                                        <Condition Binding="{Binding Page}" Value="Bass" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <Polygon
                                                Width="20"
                                                Height="16"
                                                Margin="0,0,8,0"
                                                Fill="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                                Points="{StaticResource HexagonPoints}"
                                                Stretch="Fill" />
                                            <Polygon
                                                Width="20"
                                                Height="16"
                                                Margin="8,0,0,0"
                                                Fill="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                                Points="{StaticResource HexagonPoints}"
                                                Stretch="Fill" />
                                        </StackPanel>
                                        <StackPanel Margin="0,3,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                            <Polygon
                                                Width="20"
                                                Height="16"
                                                Margin="0,0,2,0"
                                                Fill="Transparent"
                                                Points="{StaticResource HexagonPoints}"
                                                Stretch="Fill"
                                                Stroke="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                                StrokeThickness="1.5" />
                                            <Polygon
                                                Width="20"
                                                Height="16"
                                                Margin="2,0,0,0"
                                                Fill="Transparent"
                                                Points="{StaticResource HexagonPoints}"
                                                Stretch="Fill"
                                                Stroke="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                                StrokeThickness="1.5" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Margin="4,0,0,0">
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <Polygon
                                                Width="15"
                                                Height="12"
                                                Margin="0,0,2,0"
                                                Fill="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                                Points="{StaticResource HexagonPoints}"
                                                Stretch="Fill" />
                                            <Polygon
                                                Width="15"
                                                Height="12"
                                                Margin="2,0,0,0"
                                                Fill="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                                Points="{StaticResource HexagonPoints}"
                                                Stretch="Fill" />
                                        </StackPanel>
                                        <StackPanel Margin="0,2,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                            <Polygon
                                                Width="15"
                                                Height="12"
                                                Margin="0,0,2,0"
                                                Fill="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                                Points="{StaticResource HexagonPoints}"
                                                Stretch="Fill" />
                                            <Polygon
                                                Width="15"
                                                Height="12"
                                                Margin="2,0,0,0"
                                                Fill="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                                Points="{StaticResource HexagonPoints}"
                                                Stretch="Fill" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <!--  Mini icon for the 1st laser fader's effect (see MainWindow.UpdateLaserWaveFaderEffect):
                                      4 short bars arranged in a square, each tilted so it peaks in the
                                      middle - reads as the laser's wandering line rather than a flat beam.  -->
                                <StackPanel
                                    Grid.Row="0"
                                    Margin="5,5,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Index}" Value="1" />
                                                        <Condition Binding="{Binding Page}" Value="Laser" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                        <Polyline
                                            Width="15"
                                            Height="8"
                                            Margin="0,0,2,0"
                                            Points="0,8 7.5,0 15,8"
                                            Stretch="Fill"
                                            Stroke="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                            StrokeLineJoin="Round"
                                            StrokeThickness="3" />
                                        <Polyline
                                            Width="15"
                                            Height="8"
                                            Margin="2,0,0,0"
                                            Points="0,8 7.5,0 15,8"
                                            Stretch="Fill"
                                            Stroke="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                            StrokeLineJoin="Round"
                                            StrokeThickness="3" />
                                    </StackPanel>
                                    <StackPanel Margin="0,2,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                        <Polyline
                                            Width="15"
                                            Height="8"
                                            Margin="0,0,2,0"
                                            Points="0,8 7.5,0 15,8"
                                            Stretch="Fill"
                                            Stroke="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                            StrokeLineJoin="Round"
                                            StrokeThickness="3" />
                                        <Polyline
                                            Width="15"
                                            Height="8"
                                            Margin="2,0,0,0"
                                            Points="0,8 7.5,0 15,8"
                                            Stretch="Fill"
                                            Stroke="{Binding Value, Converter={StaticResource FaderActivationToBrushConverter}}"
                                            StrokeLineJoin="Round"
                                            StrokeThickness="3" />
                                    </StackPanel>
                                </StackPanel>
                                </Grid>

                                <!--  How many beats apart this fader's effect fires (1 = every beat) - not wired to any actual triggering yet. See MidiFader.BeatInterval.  -->
                                <TextBlock
                                    Grid.Row="0"
                                    Margin="0,2,6,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="#AAFFFFFF"
                                    Text="{Binding DisplayLabel}" />

                                <!--  Shown while this fader is invalidated - forced to 0% because it
                                      conflicted with another fader effect that just activated (see
                                      MainWindow.RegisterConflict/MidiFader.Invalidate). Stays lit until
                                      the real fader is physically moved back to 0%, matching the
                                      virtual value already sitting there. The "!" is just text colored
                                      the same as the box background, reading as a cutout rather than an
                                      overlay against the solid red circle behind it.  -->
                                <Grid
                                    Grid.Row="0"
                                    Width="14"
                                    Height="14"
                                    Margin="0,26,6,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Visibility="{Binding IsInvalidated, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Ellipse Fill="#FFCC0000" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="#FF040404"
                                        Text="!" />
                                </Grid>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding Value, Converter={StaticResource DoubleToStarGridLengthConverter}}" />
                                        <ColumnDefinition Width="{Binding RemainingValue, Converter={StaticResource DoubleToStarGridLengthConverter}}" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Fill="#FF00AEEF" />
                                    <Rectangle Grid.Column="1" Fill="#FF040404" />
                                </Grid>
                            </Grid>
                        </Border>
</UserControl>
